# ── Supabase (client + server) ────────────────────────────────────────────────
# Local dev defaults shown; production values come from your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only. NEVER expose to the client or commit. Used by route handlers
# that must bypass RLS deliberately (e.g. /api/sync reconciliation).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Edge Function secrets (set via `supabase secrets set`):
MATCH_BATCH_CRON_SECRET=replace-with-random-secret
SYNC_ENDPOINT_RATE_LIMIT_PER_MIN=60

# ── Deployment (Render) ──────────────────────────────────────────────────────
NODE_ENV=production
